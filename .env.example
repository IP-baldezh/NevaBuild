# ==========================================
# NEVA BUILD — Переменные окружения
# ==========================================

# База данных PostgreSQL
# Для локальной разработки (Next.js на хосте + PostgreSQL в Docker):
DATABASE_URL="postgresql://neva:neva@localhost:5432/nevabuild?schema=public"

# Параметры для PostgreSQL контейнера
POSTGRES_USER="neva"
POSTGRES_PASSWORD="neva"
POSTGRES_DB="nevabuild"

# Секрет для авторизации NextAuth (в проде: openssl rand -base64 32)
AUTH_SECRET="neva_build_development_secret_key_32_characters_minimum"
AUTH_TRUST_HOST="true"

# Публичный URL приложения
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Бутстрап администратора (true при первом старте)
BOOTSTRAP="true"
ADMIN_EMAIL="admin@nevabuildexpo.ru"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Администратор"

# Настройки почты (SMTP) — опционально, без них формы работают, отправка писем логируется/пропускается
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="NEVA BUILD <info@neva-expo.ru>"
ORGANIZER_EMAIL="info@neva-expo.ru"

# ЮKassa (приём платежей) — опционально, без них используется тестовый mock-режим
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_RETURN_URL=""

# Redis (кэш / rate-limit) — опционально
REDIS_URL=""
